{
  "name": "alsense",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace @alsense/web run dev",
    "dev:api": "npm --workspace @alsense/api run dev",
    "build": "npm --workspace @alsense/web run build && npm --workspace @alsense/api run build",
    "test:web": "npm --workspace @alsense/web run test"
  },
  "devDependencies": {"npm-run-all": "^4.1.5"}
}
